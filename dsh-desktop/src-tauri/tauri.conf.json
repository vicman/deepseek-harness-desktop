{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "identifier": "com.vicmandev.dsh.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "publisher": "Victor Manuel Agudelo",
    "copyright": "© 2026 Victor Manuel Agudelo <vicmandev@gmail.com>",
    "category": "DeveloperTool",
    "shortDescription": "Agente de codificación con IA de DeepSeek",
    "longDescription": "DeepSeek Harness como aplicación de escritorio nativa. Arranca el servidor local automáticamente, muestra una pantalla de carga y abre la interfaz en una ventana propia, sin navegador.",
    "homepage": "https://www.deepseek.com/harness/",
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["libc6 (>= 2.39)"],
        "files": {
          "/usr/share/dsh-desktop/ui/splash.html": "../ui/splash.html",
          "/usr/share/doc/deep-seek-harness/copyright": "../debian/copyright",
          "/usr/share/doc/deep-seek-harness/changelog.gz": "../debian/changelog.gz"
        }
      }
    }
  }
}
